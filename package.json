{
    "name": "@nouvelle-lune/pi-dock-protocol",
    "version": "0.1.0",
    "description": "Shared scoped registry and contribution contract for the Lune dock",
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "default": "./src/index.js"
        },
        "./host": {
            "types": "./src/host.d.ts",
            "default": "./src/host.js"
        }
    },
    "files": [
        "src",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "node --experimental-strip-types --test 'test/**/*.test.ts'"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Nouvelle-Lune/lune-dock-protocol.git"
    },
    "peerDependencies": {
        "@earendil-works/pi-coding-agent": "*",
        "@earendil-works/pi-tui": "*"
    },
    "devDependencies": {
        "@earendil-works/pi-coding-agent": "1.0.0",
        "@earendil-works/pi-tui": "1.0.0",
        "@types/node": "^22.20.2",
        "typescript": "5.9.3"
    },
    "engines": {
        "node": ">=22.19.0"
    },
    "author": "Nouvelle-Lune",
    "license": "MIT"
}
